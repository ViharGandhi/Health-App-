# ─────────────────────────────────────────────
# Google Health API / OAuth2 credentials
# ─────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "Google Health API"
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web Application)
# 4. Set Authorized redirect URI to: http://localhost:8000/api/auth/callback
# 5. Copy the Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─────────────────────────────────────────────
# App settings
# ─────────────────────────────────────────────
# Secret key for session signing (any long random string)
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Backend URL (for OAuth callback construction)
BACKEND_URL=http://localhost:8000

# ─────────────────────────────────────────────
# User profile (used for strain max HR calc)
# ─────────────────────────────────────────────
USER_AGE=22
USER_NAME=User

# Sleep stress: set only after checking a real HRV payload's window alignment.
# SLEEP_STRESS_HRV_ANCHOR=start
# SLEEP_STRESS_DB_PATH=data/sleep_stress.sqlite3
